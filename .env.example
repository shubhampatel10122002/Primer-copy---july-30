# Copy to .env.local and fill in. .env.local is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# OpenAI does two separate jobs here, and they never overlap:
#   - the EARS: a Realtime TRANSCRIPTION session. It does no turn detection —
#     the mic button is the turn — and it cannot speak.
#   - the VOICE: /v1/audio/speech, which reads exactly the text it is given.
OPENAI_API_KEY=
# The TTS voice: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer.
OPENAI_TTS_VOICE=
# The transcription model. Leave blank to walk a fallback list headed by
# gpt-live-transcribe, the current low-latency streaming model. Being listed in
# /v1/models does not mean your project may use it, so run
# `npm run realtime:check` — it opens a real session with each one, runs a
# complete turn through it, and prints the exact value to paste here.
OPENAI_TRANSCRIBE_MODEL=
# Latency/accuracy trade-off for streaming transcription: more delay buys the
# model more audio context and a better word error rate. Default: minimal,
# because a child is waiting for an answer at the end of every turn.
OPENAI_TRANSCRIBE_DELAY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primer

# Optional overrides
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/session
