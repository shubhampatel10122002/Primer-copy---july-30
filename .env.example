# Copy to .env.local and fill in. .env.local is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# OpenAI does two separate jobs here:
#   - the EARS: a Realtime session for turn detection + transcription. It never speaks.
#   - the VOICE: /v1/audio/speech, which reads exactly the text it is given.
OPENAI_API_KEY=
# The Realtime SESSION model. Only turn detection and transcription run on it —
# it never speaks. Default: gpt-realtime.
OPENAI_REALTIME_MODEL=
# The TTS voice: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer.
OPENAI_TTS_VOICE=
# The transcription model, which is SEPARATE from the session model above.
# Leave blank to walk a fallback list. Being listed in /v1/models does not mean
# your project may use it, so run `npm run realtime:check` — it opens a real
# session with each one and prints the exact value to paste here.
OPENAI_TRANSCRIBE_MODEL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primer

# Optional overrides
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/session
