# Copy to .env.local and fill in. .env.local is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# OpenAI does two separate jobs here:
#   - the EARS: a Realtime session for turn detection + transcription. It never speaks.
#   - the VOICE: /v1/audio/speech, which reads exactly the text it is given.
OPENAI_API_KEY=
# Optional. Default model gpt-realtime, voice "coral".
OPENAI_REALTIME_MODEL=
OPENAI_TTS_VOICE=
# Optional. Leave blank to walk the fallback list; `npm run realtime:check`
# prints which transcription models your project can actually use.
OPENAI_TRANSCRIBE_MODEL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primer

# Optional overrides
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/session
